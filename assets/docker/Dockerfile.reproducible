# syntax=docker/dockerfile:1
#
# Built via `docker buildx build`, cached layer-by-layer through the GitHub Actions cache
# backend (`--cache-from/--cache-to type=gha`) in CI — see src/github.rs and
# pipeline::docker::build_toolchain_image. Layers below are ordered least- to most-volatile
# (apt/system setup first, version-pinned toolchain installs last) so a bump to
# RUST_VERSION or E2FSPROGS_VERSION only invalidates the cache from that layer down.
FROM ubuntu:26.04@sha256:2260313b31c8c011cd2eebe728008efac1b3982be73eb71348ea2648d2c0e09b

# Avoid tzdata prompts
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# Bootstrap ca-certificates from the base image's own default (HTTP) sources before
# switching apt to the HTTPS-only snapshot mirror below — otherwise TLS verification
# against snapshot.ubuntu.com fails with no CA trust store yet.
RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*

# Pin apt to a frozen snapshot.ubuntu.com timestamp instead of the live archive, so two
# builds of this Dockerfile weeks apart resolve gcc/binutils/musl-tools/etc. to the same
# versions — otherwise reproducibility (and SEV-SNP measurement comparison) silently
# breaks even with no repo changes. `Check-Valid-Until=false`: a historical snapshot's own
# Release file always has a long-since-passed Valid-Until date.
#
# Overridable via `[toolchain].apt_snapshot` (`--build-arg SNAPSHOT_TS=...`, see
# pipeline::docker::build_args_for) — see docs/reproducible_builds.md.
ARG SNAPSHOT_TS=20260820T000000Z
RUN rm -f /etc/apt/sources.list.d/ubuntu.sources && \
    printf 'deb [check-valid-until=no] https://snapshot.ubuntu.com/ubuntu/%s resolute main restricted universe multiverse\n\
deb [check-valid-until=no] https://snapshot.ubuntu.com/ubuntu/%s resolute-updates main restricted universe multiverse\n\
deb [check-valid-until=no] https://snapshot.ubuntu.com/ubuntu/%s resolute-security main restricted universe multiverse\n\
deb [check-valid-until=no] https://snapshot.ubuntu.com/ubuntu/%s resolute-backports main restricted universe multiverse\n' \
    "$SNAPSHOT_TS" "$SNAPSHOT_TS" "$SNAPSHOT_TS" "$SNAPSHOT_TS" \
    > /etc/apt/sources.list && \
    echo 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/99snapshot

# Force every already-installed package (openssl, libc, ...) down/up to the snapshot's
# versions too, not just what's installed below — otherwise a package newer than
# SNAPSHOT_TS on the base image causes "unmet dependencies" (seen with libssl3t64 vs.
# libssl-dev), since apt won't downgrade to satisfy a dependency without the flag.
RUN apt-get update && apt-get -y --allow-downgrades dist-upgrade

# --allow-downgrades again: this step pulls in *new* packages (systemd-boot-efi/
# systemd-ukify) whose dependency graph can pin an exact-version sibling that conflicts
# with a shared lib already resolved earlier in the same solve, even though every version
# in play comes from the one pinned SNAPSHOT_TS.
#
# gcc-15-plugin-dev: the guest kernel's GCC-plugin hardening options (latent-entropy,
# randstruct, kstack-erase) are gated on CONFIG_GCC_PLUGINS, which needs this package's
# plugin headers — without it they silently drop during `make olddefconfig` with no error
# until build_kernel.sh's own verify_config check catches it.
RUN apt-get update && apt-get install -y --allow-downgrades \
    build-essential gcc-15-plugin-dev cpio jq python3 python3-pip ccache curl git musl-tools bc rsync golang cmake linux-libc-dev \
    systemd-ukify systemd-boot-efi flex bison libssl-dev libelf-dev wget

# musl-tools no longer symlinks the Linux kernel UAPI headers (linux-libc-dev only provides
# them under glibc's include paths) into musl's own include tree. Without this, any crate
# whose C sources include kernel headers directly (e.g. aws-lc-fips-sys's <linux/random.h>)
# fails to cross-compile to x86_64-unknown-linux-musl.
RUN ln -s /usr/include/linux /usr/include/x86_64-linux-musl/linux && \
    ln -s /usr/include/asm-generic /usr/include/x86_64-linux-musl/asm-generic && \
    ln -s /usr/include/x86_64-linux-gnu/asm /usr/include/x86_64-linux-musl/asm

# `sev-snp-measure` (cloned at build-script runtime — see script_sev_snp_measurement)
# declares `cryptography` as a dependency but nothing installs it; the module that needs
# it isn't exercised by this project's `--mode snp` invocation today, but a future
# sev-snp-measure update could start importing it eagerly. Deliberately unpinned: since
# it's never on this project's actual call path, it can't affect reproducibility or the
# measurement either way.
RUN pip3 install --break-system-packages --no-cache-dir --no-deps cryptography

# Install a specific, fixed version of Rust. Overridable via `[toolchain].rust_version`.
ARG RUST_VERSION=1.98.0
RUN curl --proto '=https' --tlsv1.3 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain "$RUST_VERSION"
ENV PATH="/root/.cargo/bin:${PATH}"
RUN rustup target add x86_64-unknown-linux-musl

# Statically-linked `mke2fs`, bundled into `storage.mode = "persistent"` images (see
# pipeline::docker::rootfs_script) so the guest can format `/dev/vda` as ext4 — there's no
# userspace in the guest's own initramfs to do this otherwise. Everything not needed for
# `mke2fs -t ext4` (fsck, debugfs, resize2fs, fuse2fs, uuidd, ...) is trimmed. Overridable
# via `[toolchain].e2fsprogs_version`/`e2fsprogs_sha256`.
#
# BUILD_E2FSPROGS (derived from `[storage].mode` — see
# pipeline::docker::helpers::build_args_for) skips this step entirely for RAM-mode.
ARG BUILD_E2FSPROGS=0
ARG E2FSPROGS_VERSION=1.47.4
ARG E2FSPROGS_SHA256=da274408bebbfd13a5a2fc3cfc66e3ffff17c48534673aa67f88d49b99123b96
RUN if [ "$BUILD_E2FSPROGS" = "1" ]; then \
        curl -fL -o /tmp/e2fsprogs.tar.gz \
            "https://www.kernel.org/pub/linux/kernel/people/tytso/e2fsprogs/v${E2FSPROGS_VERSION}/e2fsprogs-${E2FSPROGS_VERSION}.tar.gz" && \
        echo "${E2FSPROGS_SHA256}  /tmp/e2fsprogs.tar.gz" | sha256sum -c - && \
        mkdir -p /tmp/e2fsprogs-src && tar -xzf /tmp/e2fsprogs.tar.gz -C /tmp/e2fsprogs-src --strip-components=1 && \
        cd /tmp/e2fsprogs-src && \
        CC=musl-gcc ./configure \
            --disable-nls --disable-uuidd --disable-tls --disable-defrag --disable-debugfs \
            --disable-imager --disable-resizer --disable-backtrace --disable-fuse2fs \
            --disable-mmp --disable-tdb --enable-libuuid --enable-libblkid --without-libarchive \
            LDFLAGS=-static && \
        make -j"$(nproc)" && \
        mkdir -p /opt/e2fsprogs/sbin && \
        cp misc/mke2fs /opt/e2fsprogs/sbin/mke2fs && \
        strip /opt/e2fsprogs/sbin/mke2fs && \
        rm -rf /tmp/e2fsprogs.tar.gz /tmp/e2fsprogs-src ; \
    fi

WORKDIR /workspace
