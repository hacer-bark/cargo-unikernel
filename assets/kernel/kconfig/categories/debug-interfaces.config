# Category: debug_interfaces (config field: hardening.kernel.disable_debug_interfaces)
#
# Removes every way to introspect/manipulate a running kernel: debugfs, SysRq, kprobes/
# ftrace, kcov, kgdb, fault/notifier-error injection, /proc/kcore+vmcore, debug-info/symbols.
# Applied by default; set `disable_debug_interfaces = false` for local debugging only.
#
# CONFIG_DEBUG_KERNEL is deliberately NOT touched here — it only unlocks other options'
# prompts; self-protection.config sets it, next to what depends on it.
CONFIG_MAGIC_SYSRQ=disable
CONFIG_DEVMEM=disable
CONFIG_DEBUG_FS=disable
CONFIG_PROC_KCORE=disable
CONFIG_PROC_VMCORE=disable
CONFIG_PROC_PAGE_MONITOR=disable
CONFIG_KPROBES=disable
CONFIG_KPROBE_EVENTS=disable
CONFIG_UPROBE_EVENTS=disable
CONFIG_FTRACE=disable
CONFIG_GENERIC_TRACER=disable
CONFIG_FUNCTION_TRACER=disable
CONFIG_STACK_TRACER=disable
CONFIG_HIST_TRIGGERS=disable
CONFIG_BLK_DEV_IO_TRACE=disable
CONFIG_MMIOTRACE=disable
CONFIG_KGDB=disable
CONFIG_KCOV=disable
CONFIG_LATENCYTOP=disable
CONFIG_DEBUG_KMEMLEAK=disable
CONFIG_NOTIFIER_ERROR_INJECTION=disable
CONFIG_FAULT_INJECTION=disable
CONFIG_PROVE_LOCKING=disable
CONFIG_LKDTM=disable
CONFIG_DEBUG_INFO=disable
CONFIG_KALLSYMS=disable
CONFIG_KALLSYMS_ALL=disable
CONFIG_X86_MSR=disable
CONFIG_DEVPORT=disable
