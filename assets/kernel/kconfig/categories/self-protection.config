# Category: self_protection (config field: hardening.kernel.kernel_self_protection)
#
# KSPP baseline plus memory/structure hardening: ASLR, zeroing freed/allocated memory,
# write-protected kernel/module text, hardened slab/usercopy, stack-protector/
# FORTIFY_SOURCE, structure layout randomization, the Lockdown LSM, and disabling
# userfaultfd/live-patching/ACPI table upgrades. Applied by default, both profiles. See
# `kernel_cmdline`'s `lockdown=integrity`/`lockdown=confidentiality` for what actually
# activates Lockdown. Cross-checked against upstream KSPP Recommended_Settings and the
# a13xp0p0v/kernel-hardening-checker x86_64 list (2026).
#
# Unlocks the prompts CONFIG_DEBUG_SG/DEBUG_NOTIFIERS/DEBUG_VIRTUAL/SCHED_STACK_END_CHECK
# depend on — not itself a debug interface, those stay disabled in debug-interfaces.config.
CONFIG_DEBUG_KERNEL=enable

CONFIG_SECURITY=enable
CONFIG_SECURITY_LOCKDOWN_LSM=enable
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=enable
CONFIG_SECURITY_YAMA=enable
CONFIG_SECURITY_LANDLOCK=enable
CONFIG_LSM=set-str:lockdown,yama,landlock
CONFIG_RANDOMIZE_BASE=enable
CONFIG_RANDOMIZE_MEMORY=enable
CONFIG_ARCH_MMAP_RND_BITS=set-val:32
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=enable
CONFIG_INIT_ON_FREE_DEFAULT_ON=enable
CONFIG_STRICT_KERNEL_RWX=enable
CONFIG_SLAB_FREELIST_RANDOM=enable
CONFIG_SLAB_FREELIST_HARDENED=enable
CONFIG_RANDOM_KMALLOC_CACHES=enable
CONFIG_HARDENED_USERCOPY=enable
CONFIG_FORTIFY_SOURCE=enable
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=enable
CONFIG_ZERO_CALL_USED_REGS=enable
CONFIG_IOMMU_SUPPORT=enable
CONFIG_SLAB_MERGE_DEFAULT=disable
CONFIG_SHUFFLE_PAGE_ALLOCATOR=enable
CONFIG_BUG_ON_DATA_CORRUPTION=enable

# CONFIG_STRICT_DEVMEM/CONFIG_IO_STRICT_DEVMEM aren't requested: both depend on CONFIG_DEVMEM,
# which debug-interfaces.config disables — no /dev/mem to filter is strictly stronger.
CONFIG_GCC_PLUGIN_LATENT_ENTROPY=enable
CONFIG_VMAP_STACK=enable

# CONFIG_INIT_STACK_ALL_ZERO and CONFIG_GCC_PLUGIN_STRUCTLEAK_BYREF_ALL are alternatives in
# one Kconfig choice — ALL_ZERO is the stronger (every local, not just by-reference
# aggregates) and KSPP's recommendation.
CONFIG_INIT_STACK_ALL_ZERO=enable

# CONFIG_GCC_PLUGIN_RANDSTRUCT isn't requested alongside CONFIG_RANDSTRUCT_FULL: it's a
# `def_bool` derived from GCC_PLUGINS && RANDSTRUCT, not directly settable — it still
# resolves true since the build image installs the plugin headers package.
CONFIG_RANDSTRUCT_FULL=enable

# CONFIG_PAGE_POISONING is deliberately absent: redundant with CONFIG_INIT_ON_FREE_DEFAULT_ON
# above, which also covers the slab allocator.
CONFIG_USERFAULTFD=disable
CONFIG_LDISC_AUTOLOAD=disable
CONFIG_LIVEPATCH=disable
CONFIG_ACPI_TABLE_UPGRADE=disable
CONFIG_COMPAT_VDSO=disable

# Blocks /proc/<pid>/mem writes via FOLL_FORCE — the remaining route to another same-uid
# process's memory without ptrace (see main.rs's set_self_non_dumpable).
CONFIG_PROC_MEM_NO_FORCE=enable

# Separate kmalloc buckets for user-controlled allocation sizes, so a heap spray can't land
# in the same cache as its target.
CONFIG_SLAB_BUCKETS=enable

# UBSAN_TRAP turns a caught array-bounds violation into a crash instead of logging and
# carrying on into the corruption just detected.
CONFIG_UBSAN=enable
CONFIG_UBSAN_BOUNDS=enable
CONFIG_UBSAN_TRAP=enable

# Stack canaries, plus KSPP's stronger-than-default variant.
CONFIG_STACKPROTECTOR=enable
CONFIG_STACKPROTECTOR_STRONG=enable
CONFIG_SCHED_STACK_END_CHECK=enable

# Kernel stack erasure on syscall return (>=6.17 name for the old GCC_PLUGIN_STACKLEAK) —
# closes stale-stack-data leaks between syscalls, same class of bug INIT_STACK_ALL_ZERO
# closes for uninitialized locals.
CONFIG_KSTACK_ERASE=enable
CONFIG_KSTACK_ERASE_METRICS=disable
CONFIG_KSTACK_ERASE_RUNTIME_DISABLE=disable

# Debug-sounding, but KSPP-recommended integrity assertions that turn a corrupted-data
# exploit primitive into an immediate crash. Need CONFIG_DEBUG_KERNEL above.
CONFIG_DEBUG_NOTIFIERS=enable
CONFIG_DEBUG_LIST=enable
CONFIG_LIST_HARDENED=enable
CONFIG_DEBUG_VIRTUAL=enable
CONFIG_DEBUG_SG=enable

# Page-table-entry provenance checks (each mapped page verified to have exactly one owner) —
# catches use-after-free/double-mapping bugs in the page-table code at the point of
# corruption instead of instructions later when the stale mapping gets abused.
CONFIG_PAGE_TABLE_CHECK=enable
CONFIG_PAGE_TABLE_CHECK_ENFORCED=enable

# Sampling heap-overflow/use-after-free detector — one guarded allocation per 100ms
# (upstream default), negligible average overhead.
CONFIG_KFENCE=enable
CONFIG_KFENCE_SAMPLE_INTERVAL=set-val:100

# Intel CET / equivalent: hardware-enforced indirect-branch integrity for kernel code. Inert
# without a CET-capable CPU, so a strict no-op-or-better to compile in. Not paired with
# CONFIG_X86_USER_SHADOW_STACK — that's glibc userspace shadow-stack, and every app here is
# statically linked against musl.
CONFIG_X86_KERNEL_IBT=enable
