# Category: self_protection (config field: hardening.kernel.kernel_self_protection)
#
# KSPP (Kernel Self Protection Project) baseline plus memory/structure hardening: address
# space randomization, zeroing freed/allocated memory, write-protected kernel/module text,
# hardened slab allocator, hardened usercopy, stack-protector/FORTIFY_SOURCE, structure
# layout randomization, page poisoning, the Lockdown LSM, and disabling userfaultfd/
# live-patching/ACPI table upgrades. This is the "generic kernel hardening" bucket — applied
# by default, for both profiles. Every prerequisite the Lockdown LSM needs (modules/kexec/
# devmem/hibernation already disabled) is universal, so casual gets the same defense-in-depth
# at effectively zero cost; see `pipeline::docker::CASUAL_CMDLINE`/`examples/*.toml`'s
# `kernel_cmdline` for the `lockdown=integrity`/`lockdown=confidentiality` boot flag that
# actually activates it.
#
# Cross-checked against the upstream KSPP Recommended_Settings and the
# a13xp0p0v/kernel-hardening-checker x86_64 preference list (2026) — every option below that
# has a KSPP/hardening-checker equivalent is set to that project's recommended value.
CONFIG_SECURITY_LOCKDOWN_LSM=enable
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=enable
CONFIG_SECURITY_YAMA=enable
CONFIG_SECURITY_LANDLOCK=enable
CONFIG_LSM=set-str:lockdown,yama,landlock
CONFIG_RANDOMIZE_BASE=enable
CONFIG_RANDOMIZE_MEMORY=enable
CONFIG_ARCH_MMAP_RND_BITS=set-val:32
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=enable
CONFIG_INIT_ON_FREE_DEFAULT_ON=enable
CONFIG_STRICT_KERNEL_RWX=enable
CONFIG_STRICT_MODULE_RWX=enable
CONFIG_SLAB_FREELIST_RANDOM=enable
CONFIG_SLAB_FREELIST_HARDENED=enable
CONFIG_RANDOM_KMALLOC_CACHES=enable
CONFIG_HARDENED_USERCOPY=enable
CONFIG_HARDENED_USERCOPY_FALLBACK=disable
CONFIG_HARDENED_USERCOPY_PAGESPAN=disable
CONFIG_FORTIFY_SOURCE=enable
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=enable
CONFIG_ZERO_CALL_USED_REGS=enable
CONFIG_IOMMU_SUPPORT=enable
CONFIG_IOMMU_DEFAULT_DMA_STRICT=enable
CONFIG_SLAB_MERGE_DEFAULT=disable
CONFIG_SHUFFLE_PAGE_ALLOCATOR=enable
CONFIG_BUG_ON_DATA_CORRUPTION=enable
CONFIG_STRICT_DEVMEM=enable
CONFIG_IO_STRICT_DEVMEM=enable
CONFIG_INIT_STACK_ALL_ZERO=enable
CONFIG_GCC_PLUGIN_RANDSTRUCT=enable
CONFIG_RANDSTRUCT_FULL=enable
CONFIG_GCC_PLUGIN_STRUCTLEAK=enable
CONFIG_GCC_PLUGIN_STRUCTLEAK_BYREF_ALL=enable
CONFIG_GCC_PLUGIN_LATENT_ENTROPY=enable
CONFIG_PAGE_POISONING=enable
CONFIG_PAGE_POISONING_ZERO=enable
CONFIG_VMAP_STACK=enable
CONFIG_SECRETMEM=enable
CONFIG_USERFAULTFD=disable
CONFIG_LDISC_AUTOLOAD=disable
CONFIG_LIVEPATCH=disable
CONFIG_ACPI_TABLE_UPGRADE=disable
CONFIG_COMPAT_VDSO=disable

# Stack canaries, plus KSPP's stronger-than-default variant.
CONFIG_STACKPROTECTOR=enable
CONFIG_STACKPROTECTOR_STRONG=enable
CONFIG_SCHED_STACK_END_CHECK=enable

# Kernel stack erasure on syscall return (CONFIG_KSTACK_ERASE, the >=6.17 name for what used
# to be CONFIG_GCC_PLUGIN_STACKLEAK) — closes stale-stack-data info leaks between syscalls,
# the same class of bug CONFIG_INIT_STACK_ALL_ZERO closes for uninitialized locals.
CONFIG_KSTACK_ERASE=enable
CONFIG_KSTACK_ERASE_METRICS=disable
CONFIG_KSTACK_ERASE_RUNTIME_DISABLE=disable

# Debug-sounding, but these are correctness/integrity assertions on core kernel data
# structures (credentials, linked lists, notifier chains, scatter-gather lists, virtual
# address bookkeeping) that turn a corrupted-data exploit primitive into an immediate,
# recognizable crash instead of silent further exploitation — KSPP recommends all of these
# on unconditionally, not just for debug builds.
CONFIG_DEBUG_CREDENTIALS=enable
CONFIG_DEBUG_NOTIFIERS=enable
CONFIG_DEBUG_LIST=enable
CONFIG_LIST_HARDENED=enable
CONFIG_DEBUG_VIRTUAL=enable
CONFIG_DEBUG_SG=enable

# Page-table-entry provenance checks (each mapped page verified to have exactly one owner) —
# catches use-after-free / double-mapping bugs in the page-table code itself at the point of
# corruption rather than however many instructions later the stale mapping gets abused.
CONFIG_PAGE_TABLE_CHECK=enable
CONFIG_PAGE_TABLE_CHECK_ENFORCED=enable

# Sampling heap-overflow/use-after-free detector — statistically catches a fraction of heap
# corruption bugs in production at negligible average overhead (one guarded allocation per
# ~100 kmalloc calls, not every allocation).
CONFIG_KFENCE=enable
CONFIG_KFENCE_SAMPLE_INTERVAL=set-val:100

# Intel CET / equivalent: hardware-enforced indirect-branch and return-address integrity.
# Requires GCC's `-fcf-protection` support (available since GCC 9; this project's reproducible
# build image pins a GCC new enough) and a CPU with CET — on any older/non-CET CPU the kernel
# simply doesn't activate the feature at runtime, so this is a strict no-op-or-better, never a
# regression, to compile in.
CONFIG_X86_KERNEL_IBT=enable
CONFIG_X86_USER_SHADOW_STACK=enable
