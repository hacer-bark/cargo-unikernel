# Category: seccomp (config field: hardening.kernel.seccomp)
#
# Enables seccomp/seccomp-BPF syscall filtering support in the kernel (your app still has
# to install its own filter to benefit — this just makes the facility available) and
# disables a couple of legacy syscall-adjacent interfaces (sysfs-via-syscall, uselib).
CONFIG_SECCOMP=enable
CONFIG_SECCOMP_FILTER=enable
CONFIG_SYSFS_SYSCALL=disable
CONFIG_USELIB=disable
