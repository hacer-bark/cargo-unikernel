# Category: fips (config field: hardening.kernel.fips)
#
# FIPS 140-2/3 mode CAPABILITY only (fips_enabled/self-tests) — doesn't activate FIPS-mode
# crypto restrictions by itself, that needs the `fips=1` boot parameter. Unlike every other
# category here, this one defaults to disabled unless set explicitly (see build_kernel.sh).
CONFIG_CRYPTO_FIPS=enable
