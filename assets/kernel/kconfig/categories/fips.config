# Category: fips (config field: hardening.kernel.fips)
#
# FIPS 140-2/3 mode CAPABILITY only — this makes fips_enabled/self-tests available; it does
# NOT activate FIPS-mode crypto restrictions by itself (that needs the `fips=1` boot
# parameter, a separate opt-in via `kernel_cmdline`/`extra_kernel_config`). Off by default —
# see build_kernel.sh: unlike the other categories in this directory, this one defaults to
# *disabled* unless `hardening.kernel.fips = true` is set explicitly.
CONFIG_CRYPTO_FIPS=enable
