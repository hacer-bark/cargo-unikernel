# Category: legacy_subsystems (config field: hardening.kernel.disable_legacy_subsystems)
#
# Strips drivers, protocols, filesystems, and syscall-adjacent interfaces a single-purpose
# server almost never needs: sound, USB, DRM/framebuffer, wireless/Bluetooth, legacy network
# protocols, most local filesystem drivers, suspend/hibernation, coredumps, kexec/crash-dump,
# checkpoint/restore, CPUID/IOPL, 32-bit/x32 compat ABIs. Applied by default; set
# `disable_legacy_subsystems = false` to fall back to kvm_guest.config's own defaults.
#
# CONFIG_BPF_JIT stays on despite CONFIG_BPF_SYSCALL below being disabled: it also JIT-compiles
# the classic-BPF that seccomp filters compile down to, so disabling it would force every
# seccomp-adopting app onto the slow interpreted path. Unprivileged eBPF loading is already
# blocked (this + the `unprivileged_bpf_disabled=1` sysctl), so keeping it costs nothing extra.
#
# CONFIG_IO_URING is disabled despite being a real I/O throughput win: it's also one of the
# most-exploited kernel subsystems in recent years. Re-enable narrowly via
# `extra_kernel_config = ["CONFIG_IO_URING=enable"]` if your workload needs it.
CONFIG_USB_SUPPORT=disable
CONFIG_BINFMT_MISC=disable
CONFIG_COMPAT=disable
CONFIG_IA32_EMULATION=disable
CONFIG_X86_X32_ABI=disable
CONFIG_MODIFY_LDT_SYSCALL=disable
CONFIG_BPF_SYSCALL=disable
CONFIG_EFI_TEST=disable
CONFIG_EFI_CUSTOM_SSDT_OVERLAYS=disable
CONFIG_ACPI_CUSTOM_METHOD=disable
CONFIG_SOUND=disable
CONFIG_IO_URING=disable
CONFIG_KSM=disable
CONFIG_VT=disable
CONFIG_NUMA=disable
CONFIG_SCTP=disable
CONFIG_DCCP=disable
CONFIG_RDS=disable
CONFIG_TIPC=disable
CONFIG_ATM=disable
CONFIG_L2TP=disable
CONFIG_BRIDGE=disable
CONFIG_VLAN_8021Q=disable
CONFIG_X25=disable
CONFIG_NET_SCHED=disable
CONFIG_NETFILTER=disable
CONFIG_WLAN=disable
CONFIG_BT=disable
CONFIG_DRM=disable
CONFIG_FB=disable
CONFIG_USB=disable
# All namespaces, not only CONFIG_USER_NS — `clone`/`clone3` can create one directly and
# can't be seccomp-denied without breaking thread creation. See cargo-unikernel-init::seccomp.
CONFIG_NAMESPACES=disable
CONFIG_USER_NS=disable
CONFIG_COREDUMP=disable
CONFIG_KEXEC=disable
CONFIG_KEXEC_FILE=disable
CONFIG_SUSPEND=disable
CONFIG_HIBERNATION=disable
CONFIG_WIRELESS=disable
CONFIG_ATA=disable
CONFIG_SCSI_LOWLEVEL=disable
CONFIG_INPUT_MOUSE=disable
CONFIG_INPUT_JOYSTICK=disable
CONFIG_INPUT_TOUCHSCREEN=disable
# CONFIG_FAT_FS has no prompt of its own — kvm_guest.config's CONFIG_VFAT_FS re-selects it
# regardless, so VFAT_FS is the actual switch.
CONFIG_FAT_FS=disable
CONFIG_VFAT_FS=disable
CONFIG_MSDOS_FS=disable
CONFIG_NETWORK_FILESYSTEMS=disable
CONFIG_MISC_FILESYSTEMS=disable
CONFIG_HAMRADIO=disable
CONFIG_CAN=disable
CONFIG_LEGACY_PTYS=disable
CONFIG_LEGACY_TIOCSTI=disable
CONFIG_N_HDLC=disable
CONFIG_N_GSM=disable
CONFIG_STAGING=disable
CONFIG_MEDIA_SUPPORT=disable
CONFIG_SYSVIPC=disable
CONFIG_COMPAT_BRK=disable
CONFIG_CRASH_DUMP=disable
CONFIG_CHECKPOINT_RESTORE=disable
CONFIG_MEM_SOFT_DIRTY=disable
CONFIG_X86_CPUID=disable
CONFIG_X86_IOPL_IOPERM=disable
CONFIG_BLK_DEV_FD=disable
CONFIG_BLK_DEV_FD_RAWCMD=disable
CONFIG_MPTCP=disable
CONFIG_TLS=disable
CONFIG_CRYPTO_USER_API=disable
CONFIG_CRYPTO_USER_API_ENABLE_OBSOLETE=disable
CONFIG_CRYPTO_USER_API_HASH=disable
CONFIG_CRYPTO_USER_API_SKCIPHER=disable
CONFIG_CRYPTO_USER_API_RNG=disable
CONFIG_CRYPTO_USER_API_RNG_CAVP=disable
CONFIG_CRYPTO_USER_API_AEAD=disable

# `ss`/`netstat`-style socket introspection over netlink — no operator here to run it, and
# it's otherwise a free enumeration primitive for an attacker with a code-execution foothold.
CONFIG_INET_DIAG=disable

# `kcmp(2)` and `AIO` are legacy attack surface with no legitimate caller in a single-app
# guest. Re-enable via `extra_kernel_config = ["CONFIG_AIO=enable"]` if you need libaio-style
# direct I/O.
CONFIG_KCMP=disable
CONFIG_AIO=disable

# open_by_handle_at: resolves a filesystem-wide handle straight to an fd, skipping path-based
# access control. Also seccomp-denied — neither layer is load-bearing alone.
CONFIG_FHANDLE=disable

# AF_PACKET raw sockets — the in-kernel DHCP client doesn't need it.
CONFIG_PACKET=disable

# Every wired NIC driver in one line — virtio-net isn't under CONFIG_ETHERNET, unaffected.
CONFIG_ETHERNET=disable
