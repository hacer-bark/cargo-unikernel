# Category: legacy_subsystems (config field: hardening.kernel.disable_legacy_subsystems)
#
# Strips drivers, protocols, filesystems, and syscall-adjacent interfaces a single-purpose
# server almost never needs: sound, USB, DRM/framebuffer, wireless/Bluetooth, legacy network
# protocols (plus MPTCP/kTLS and the AF_ALG userspace-crypto socket API), most local
# filesystem drivers, suspend/hibernation, coredumps, kexec/crash-dump, checkpoint/restore,
# CPUID/IOPL access, and 32-bit/x32 compat syscall ABIs. Applied by default; set
# `disable_legacy_subsystems = false` to skip this fragment entirely and fall back to the
# kernel's own kvm_guest.config defaults for these.
#
# CONFIG_BPF_JIT is deliberately NOT disabled here even though this category disables
# CONFIG_BPF_SYSCALL (the bpf(2) syscall used to load arbitrary eBPF programs — the actual
# attack surface, independently blocked again at the sysctl layer by
# `unprivileged_bpf_disabled=1`, see hardening.rs). CONFIG_BPF_JIT also JIT-compiles the
# *classic*-BPF programs seccomp filters compile down to — disabling it would silently force
# every app that adopts a seccomp filter (which `hardening.kernel.seccomp` explicitly enables
# and encourages) onto the slow interpreted path on every syscall. Keeping the JIT costs
# nothing extra from a threat-model standpoint here, since unprivileged eBPF loading is
# already blocked two other ways, and buys back the seccomp performance the seccomp category
# is trying to make cheap to adopt.
#
# CONFIG_IO_URING is disabled despite being a genuine throughput win for I/O-heavy servers:
# it's also one of the most-exploited kernel subsystems of the last few years (frequent
# container-escape/LPE CVEs), which is why it's commonly blocked by default in
# security-conscious container runtimes. If your workload specifically benefits from it and
# you accept that trade-off, re-enable it without pulling in the rest of this category via
# `extra_kernel_config = ["CONFIG_IO_URING=enable"]`.
CONFIG_USB_SUPPORT=disable
CONFIG_BINFMT_MISC=disable
CONFIG_COMPAT=disable
CONFIG_IA32_EMULATION=disable
CONFIG_X86_X32_ABI=disable
CONFIG_MODIFY_LDT_SYSCALL=disable
CONFIG_BPF_SYSCALL=disable
CONFIG_EFI_TEST=disable
CONFIG_EFI_CUSTOM_SSDT_OVERLAYS=disable
CONFIG_ACPI_CUSTOM_METHOD=disable
CONFIG_SOUND=disable
CONFIG_IO_URING=disable
CONFIG_KSM=disable
CONFIG_VT=disable
CONFIG_NUMA=disable
CONFIG_SCTP=disable
CONFIG_DCCP=disable
CONFIG_RDS=disable
CONFIG_TIPC=disable
CONFIG_ATM=disable
CONFIG_L2TP=disable
CONFIG_BRIDGE=disable
CONFIG_VLAN_8021Q=disable
CONFIG_X25=disable
CONFIG_NET_SCHED=disable
CONFIG_NETFILTER=disable
CONFIG_WLAN=disable
CONFIG_BT=disable
CONFIG_DRM=disable
CONFIG_FB=disable
CONFIG_USB=disable
# All namespaces, not only CONFIG_USER_NS. `clone`/`clone3` can create one directly and can't
# be seccomp-denied without breaking thread creation; with this off, every CLONE_NEW* flag
# returns EINVAL regardless of syscall. See cargo-unikernel-init::seccomp.
CONFIG_NAMESPACES=disable
CONFIG_USER_NS=disable
CONFIG_COREDUMP=disable
CONFIG_KEXEC=disable
CONFIG_KEXEC_FILE=disable
CONFIG_SUSPEND=disable
CONFIG_HIBERNATION=disable
CONFIG_WIRELESS=disable
CONFIG_ATA=disable
CONFIG_SCSI_LOWLEVEL=disable
CONFIG_INPUT_MOUSE=disable
CONFIG_INPUT_JOYSTICK=disable
CONFIG_INPUT_TOUCHSCREEN=disable
# CONFIG_FAT_FS has no prompt of its own — it's a plain `select` target, and kvm_guest.config
# turns on CONFIG_VFAT_FS ahead of this fragment, which keeps re-selecting FAT_FS back to y on
# every `make olddefconfig` regardless of what's written here directly. VFAT_FS is the actual
# switch.
CONFIG_FAT_FS=disable
CONFIG_VFAT_FS=disable
CONFIG_MSDOS_FS=disable
CONFIG_NETWORK_FILESYSTEMS=disable
CONFIG_MISC_FILESYSTEMS=disable
CONFIG_HAMRADIO=disable
CONFIG_CAN=disable
CONFIG_LEGACY_PTYS=disable
CONFIG_LEGACY_TIOCSTI=disable
CONFIG_N_HDLC=disable
CONFIG_N_GSM=disable
CONFIG_STAGING=disable
CONFIG_MEDIA_SUPPORT=disable
CONFIG_SYSVIPC=disable
CONFIG_COMPAT_BRK=disable
CONFIG_CRASH_DUMP=disable
CONFIG_CHECKPOINT_RESTORE=disable
CONFIG_MEM_SOFT_DIRTY=disable
CONFIG_X86_CPUID=disable
CONFIG_X86_IOPL_IOPERM=disable
CONFIG_BLK_DEV_FD=disable
CONFIG_BLK_DEV_FD_RAWCMD=disable
CONFIG_MPTCP=disable
CONFIG_TLS=disable
CONFIG_CRYPTO_USER_API=disable
CONFIG_CRYPTO_USER_API_ENABLE_OBSOLETE=disable
CONFIG_CRYPTO_USER_API_HASH=disable
CONFIG_CRYPTO_USER_API_SKCIPHER=disable
CONFIG_CRYPTO_USER_API_RNG=disable
CONFIG_CRYPTO_USER_API_RNG_CAVP=disable
CONFIG_CRYPTO_USER_API_AEAD=disable

# `ss`/`netstat`-style TCP/UDP socket introspection over netlink. A single-app guest has no
# operator shelling in to run `ss`; disabling it removes a read-primitive an attacker who's
# already gained some code-execution foothold could otherwise use to enumerate every socket
# on the box for free.
CONFIG_INET_DIAG=disable

# `kcmp(2)` (compare two processes' fds/mm) and `AIO` (async I/O via io_submit) are both
# legacy attack surface with a history of kernel CVEs; unlike CONFIG_IO_URING (which has a
# clear, common legitimate use this project explicitly documents an opt-out for above), a
# single-app guest has no legitimate caller for either. Re-enable narrowly via
# `extra_kernel_config = ["CONFIG_AIO=enable"]` if your workload specifically depends on
# libaio-style direct I/O.
CONFIG_KCMP=disable
CONFIG_AIO=disable

# open_by_handle_at: resolves a filesystem-wide handle straight to an fd, skipping path-based
# access control entirely. Standard escape primitive, no legitimate caller here; also
# seccomp-denied, so neither layer is load-bearing alone.
CONFIG_FHANDLE=disable

# AF_PACKET raw sockets. The in-kernel DHCP client (CONFIG_IP_PNP_DHCP) doesn't need it.
CONFIG_PACKET=disable

# Every wired NIC driver in one line — virtio-net isn't under CONFIG_ETHERNET, so the only NIC
# this guest has is unaffected.
CONFIG_ETHERNET=disable
