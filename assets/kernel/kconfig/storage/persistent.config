# [storage].mode = "persistent": one virtio-blk device (/dev/vda), mounted at /var as ext4 —
# see cargo-unikernel-init::storage. Hypervisor-supplied, neither encrypted nor
# integrity-checked — see docs/threat_model.md for the sev-snp implications.
CONFIG_VIRTIO_BLK=enable
CONFIG_EXT4_FS=enable

# Would add ext2 parsing to a device that only ever holds what this guest formatted
# itself as ext4 — an unnecessary parser on a host-controlled device.
CONFIG_EXT4_USE_FOR_EXT2=disable
