# [storage].mode = "persistent": one virtio-blk device (/dev/vda), live-mounted at /var as
# ext4 (journaled) — see cargo-unikernel-common::storage. Applied after
# legacy-subsystems.config, which this doesn't need to override (ext4 isn't in that category).
CONFIG_VIRTIO_BLK=enable
CONFIG_EXT4_FS=enable
CONFIG_EXT4_USE_FOR_EXT23=enable
