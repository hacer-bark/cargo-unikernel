# [storage].mode = "persistent": one virtio-blk device (/dev/vda), live-mounted at /var as
# ext4 (journaled) — see cargo-unikernel-init::storage. Applied after
# legacy-subsystems.config, which this doesn't need to override (ext4 isn't in that category).
#
# Hypervisor-supplied, neither encrypted nor integrity-checked — see
# cargo-unikernel-init::storage and docs/threat_model.md for the sev-snp implications.
CONFIG_VIRTIO_BLK=enable
CONFIG_EXT4_FS=enable

# EXT4_USE_FOR_EXT23 would add ext2/ext3 parsing to a device that only ever holds what this
# guest formatted itself as ext4 — two unreachable parsers on a host-controlled device.
CONFIG_EXT4_USE_FOR_EXT23=disable
