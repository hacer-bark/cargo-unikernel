# Applied when `[network].mode` is "ipv6" or "dual" (env: CARGO_UNIKERNEL_NET_IPV6=1) — see
# build_kernel.sh. virtio-net plus IPv6 support; addressing itself is via SLAAC (router
# advertisements), so no kernel cmdline parameter is needed the way IPv4 needs `ip=dhcp`.
CONFIG_VIRTIO_NET=enable
CONFIG_IPV6=enable
