# Category: firewall (config field: network.firewall.enabled)
#
# The in-guest inbound packet filter (see guest/src/firewall.rs). Applied only when
# `[network.firewall].enabled` is true, and deliberately *after* categories/legacy-subsystems.
# config, which disables CONFIG_NETFILTER wholesale — a guest with the firewall turned off has
# no packet filter compiled into the kernel at all, so there is nothing in it for a compromised
# app to reconfigure, and nothing for the fragment order to leave half-enabled.
#
# Everything here is built in (=y, never =m): CONFIG_MODULES is disabled, so a subsystem that
# resolved to a module would simply not exist at runtime, and the guest's fail-closed install
# would stop the boot rather than silently leave the guest unfiltered.
CONFIG_NETFILTER=enable
CONFIG_NETFILTER_ADVANCED=enable
CONFIG_NF_TABLES=enable
CONFIG_NF_TABLES_INET=enable

# Connection tracking is what makes "outbound is unrestricted" true without opening a single
# inbound port: replies to connections the guest itself opened match `ct state established`,
# so they are admitted as state rather than by a rule anyone had to write. Without it the only
# way to allow return traffic would be to accept unsolicited packets on the same ports.
CONFIG_NF_CONNTRACK=enable
CONFIG_NF_CONNTRACK_PROCFS=disable
CONFIG_NFT_CT=enable
CONFIG_NF_DEFRAG_IPV4=enable

# The expressions the ruleset is built from — payload/meta/cmp/bitwise/range are compiled into
# nf_tables itself; only these two are separate symbols.
CONFIG_NFT_NUMGEN=disable
CONFIG_NFT_LOG=disable
