# Applied when `[network].mode = "none"` (neither CARGO_UNIKERNEL_NET_IPV4 nor
# CARGO_UNIKERNEL_NET_IPV6 is "1") — see build_kernel.sh. Explicitly disables the NIC driver
# and the IP stack rather than just omitting ipv4.config/ipv6.config, so "no networking" holds
# even if kvm_guest.config's own defaults would otherwise have turned either on.
#
# CONFIG_INET goes too, not just the drivers — no TCP/IP stack in the image at all. AF_UNIX
# (base.config) stays for local-socket apps. `[attestation]` can't be combined with this mode
# (Config::validate rejects it), so nothing here needs a TCP listener.
CONFIG_VIRTIO_NET=disable
CONFIG_INET=disable
CONFIG_IPV6=disable
