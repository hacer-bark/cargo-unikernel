# Applied when `[network].mode = "none"` (neither CARGO_UNIKERNEL_NET_IPV4 nor
# CARGO_UNIKERNEL_NET_IPV6 is "1") — see build_kernel.sh. Explicitly disables the NIC driver
# and IPv6 rather than just omitting ipv4.config/ipv6.config, so "no networking" holds even
# if kvm_guest.config's own defaults would otherwise have turned either on.
CONFIG_VIRTIO_NET=disable
CONFIG_IPV6=disable
