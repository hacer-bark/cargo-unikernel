# Always applied, for every profile.
#
# Networking is NOT here — entirely driven by `[network].mode` via
# kconfig/network/{ipv4,ipv6,none}.config, so a disabled protocol has no driver/stack at all.
CONFIG_MODULES=disable

# Unlocks the `if EXPERT` prompts several disables below need (they'd otherwise silently
# revert to `default y`), and flips CONFIG_NAMESPACES' default (`!EXPERT`), pinned explicitly
# below.
CONFIG_EXPERT=enable

# Pinned rather than left to defconfig/kvm_guest.config defaults. CONFIG_PROC_SYSCTL is the
# sharp one: cargo-unikernel-init::hardening writes every sysctl through /proc/sys and treats
# a missing path as "compiled out, nothing to restrict" — if this regressed, runtime
# hardening would go silently inert.
CONFIG_PROC_FS=enable
CONFIG_PROC_SYSCTL=enable
CONFIG_SYSFS=enable
CONFIG_TMPFS=enable
CONFIG_DEVTMPFS=enable
CONFIG_UNIX98_PTYS=enable
CONFIG_BLK_DEV_INITRD=enable
CONFIG_BINFMT_ELF=enable
CONFIG_MULTIUSER=enable
CONFIG_SHMEM=enable
CONFIG_BUG=enable
CONFIG_UNIX=enable
CONFIG_SERIAL_8250=enable
CONFIG_SERIAL_8250_CONSOLE=enable

# virtio-rng + hwrng core: makes cargo-unikernel-init::entropy's boot-time CRNG wait fast and
# reliable instead of dependent on RDSEED alone.
CONFIG_HW_RANDOM=enable
CONFIG_HW_RANDOM_VIRTIO=enable

# A hypervisor's "graceful stop" asserts the guest's ACPI power button — without these, that
# event never reaches userspace and the guest just sits there until force-killed.
CONFIG_ACPI=enable
CONFIG_ACPI_BUTTON=enable
CONFIG_INPUT=enable
CONFIG_INPUT_EVDEV=enable

# This guest runs exactly one workload process — no interactive latency to protect, so trade
# it for throughput. "Preemption Model" is a Kconfig choice; `scripts/config --enable` only
# flips CONFIG_PREEMPT_NONE's own line, so the sibling values need explicit disabling too or
# defconfig's PREEMPT_VOLUNTARY=y wins once `make olddefconfig` re-resolves the choice.
CONFIG_PREEMPT_NONE=enable
CONFIG_PREEMPT_VOLUNTARY=disable
CONFIG_PREEMPT=disable
CONFIG_PREEMPT_LAZY=disable
CONFIG_PREEMPT_DYNAMIC=disable

# BBR congestion control — throughput/latency win over cubic, no security downside. Not
# paired with CONFIG_NET_SCH_FQ: legacy-subsystems.config disables CONFIG_NET_SCHED by
# default, which would make it unreachable anyway; BBR's internal fallback pacing (since
# Linux 4.20) works fine without it.
CONFIG_TCP_CONG_BBR=enable

# Transparent hugepages, `madvise`-only (matches the boot cmdline's
# `transparent_hugepage=madvise`) — benefits opt-in memory-heavy workloads without the
# background compaction cost `always` puts on every small app. Pinned here since sev-snp's
# cmdline is user-supplied and shouldn't be the only thing this depends on.
CONFIG_TRANSPARENT_HUGEPAGE=enable
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=enable

# Raises the lowest mmap-able address from 0 to 64KB — closes off turning a kernel
# NULL-pointer deref into an attacker-controlled read/write via a pre-populated page zero.
CONFIG_DEFAULT_MMAP_MIN_ADDR=set-val:65536

# TCP SYN cookies: keeps accepting legitimate connections under a SYN-flood instead of
# exhausting the small single-app SYN backlog. No-op if networking is disabled.
CONFIG_SYN_COOKIES=enable
