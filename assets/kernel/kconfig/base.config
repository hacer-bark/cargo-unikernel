# Always applied, for every profile.
#
# Networking (virtio-net, IPv4 DHCP autoconfig, IPv6) is NOT here — it's entirely driven by
# `[network].mode` via kconfig/network/{ipv4,ipv6,none}.config, so a build with networking
# disabled genuinely has no NIC driver or IP stack compiled in, not just an unused one.
CONFIG_MODULES=disable

# Unlocks the `if EXPERT` prompts several disables below need (CONFIG_AIO, CONFIG_COREDUMP,
# CONFIG_KCMP, CONFIG_KALLSYMS, CONFIG_SYSFS_SYSCALL) — without it they silently revert to
# `default y` under `make olddefconfig`. Also flips CONFIG_NAMESPACES' default (`!EXPERT`),
# pinned explicitly below rather than left to that.
#
# CONFIG_TRIM_UNUSED_KSYMS isn't among these: its whole prompt lives inside `if MODULES` in
# kernel/module/Kconfig, so it's unreachable the moment CONFIG_MODULES=disable above applies —
# trimming unused *exported* symbols is moot with no module loader to ever look them up.
CONFIG_EXPERT=enable

# Pinned rather than inherited from defconfig/kvm_guest.config defaults. CONFIG_PROC_SYSCTL is
# the sharp one: cargo-unikernel-init::hardening writes every sysctl through /proc/sys and
# treats a missing path as "feature compiled out, nothing to restrict" — if PROC_SYSCTL ever
# regressed, the runtime hardening layer would go silently inert. The rest is what mounts.rs
# mounts, what the app execs as, and the initramfs itself.
CONFIG_PROC_FS=enable
CONFIG_PROC_SYSCTL=enable
CONFIG_SYSFS=enable
CONFIG_TMPFS=enable
CONFIG_DEVTMPFS=enable
CONFIG_UNIX98_PTYS=enable
CONFIG_BLK_DEV_INITRD=enable
CONFIG_BINFMT_ELF=enable
CONFIG_MULTIUSER=enable
CONFIG_SHMEM=enable
CONFIG_BUG=enable
CONFIG_UNIX=enable
CONFIG_SERIAL_8250=enable
CONFIG_SERIAL_8250_CONSOLE=enable

# virtio-rng + hwrng core: what makes cargo-unikernel-init::entropy's boot-time CRNG wait
# fast and reliable instead of dependent on RDSEED alone.
CONFIG_HW_RANDOM=enable
CONFIG_HW_RANDOM_VIRTIO=enable

# Graceful shutdown needs the ACPI power-button event to actually reach userspace as
# something PID 1 can read — without a consumer, a hypervisor's "graceful stop" (which
# works by asserting the guest's ACPI power button, not by signaling any guest process)
# has nothing to land on and the guest just sits there until force-killed.
CONFIG_ACPI=enable
CONFIG_ACPI_BUTTON=enable
CONFIG_INPUT=enable
CONFIG_INPUT_EVDEV=enable

# This guest ever runs exactly one real workload process (plus PID 1, which spends almost all
# of its life blocked in waitpid/sleep) — there's no interactive/desktop workload whose
# scheduling latency voluntary/full preemption exists to protect. CONFIG_PREEMPT_NONE trades
# that latency guarantee (irrelevant here) for higher throughput and lower scheduling overhead
# on the one hot path that matters.
#
# CONFIG_PREEMPT_DYNAMIC has to go with it — left on (the default), it makes PREEMPT_NONE just
# a runtime default a `preempt=` boot parameter can override, keeping the static-call
# indirection this is meant to remove.
#
# "Preemption Model" is a Kconfig choice, and x86_64_defconfig already ships
# CONFIG_PREEMPT_VOLUNTARY=y ahead of this fragment in the generated .config. `scripts/config
# --enable` only flips CONFIG_PREEMPT_NONE's own line in place; it doesn't touch sibling choice
# members, so the untouched PREEMPT_VOLUNTARY=y line — sitting later in the file — is what wins
# once `make olddefconfig` re-resolves the choice. The sibling values need disabling here too.
CONFIG_PREEMPT_NONE=enable
CONFIG_PREEMPT_VOLUNTARY=disable
CONFIG_PREEMPT=disable
CONFIG_PREEMPT_LAZY=disable
CONFIG_PREEMPT_DYNAMIC=disable

# BBR congestion control — a real throughput/latency win for network-facing servers over the
# kernel's default (cubic), with no security downside. Always compiled in regardless of
# [hardening.runtime] toggles; see hardening.rs's TcpHardening category for the sysctl that
# actually selects it as the default. Deliberately NOT paired with CONFIG_NET_SCH_FQ (the qdisc
# BBR is designed to pace through ideally): kconfig/categories/legacy-subsystems.config disables
# CONFIG_NET_SCHED by default for attack-surface reduction, which would make NET_SCH_FQ
# unreachable and silently dropped by `make olddefconfig` anyway. BBR has used internal
# fallback pacing (no qdisc required) since Linux 4.20, so it still works — just without the
# extra fairness/pacing precision fq would add on top.
CONFIG_TCP_CONG_BBR=enable

# Transparent hugepages, `madvise`-only (not `always` — the boot cmdline's
# `transparent_hugepage=madvise` picks that mode, see pipeline::docker::CASUAL_CMDLINE):
# benefits memory-heavy workloads (large heaps, JIT runtimes) that opt in via madvise(), without
# putting every small app on a background khugepaged/compaction hot path it gets no benefit
# from, and without `always` mode's occasional latency spikes from synchronous compaction.
#
# The Kconfig choice defaults to `always`, so the mode is pinned here too — on sev-snp the
# cmdline is user-supplied (`[sev_snp].kernel_cmdline`) and shouldn't be the only thing this
# depends on.
CONFIG_TRANSPARENT_HUGEPAGE=enable
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=enable

# Raises the lowest address userspace is allowed to mmap from 0 to 64KB. A NULL-pointer
# dereference in kernel code that then treats the NULL as a userspace pointer (a real,
# recurring class of kernel LPE bugs) can no longer be turned into an arbitrary read/write by
# an attacker who first mmaps page zero and populates it — there's simply nothing mappable
# there to populate. No workload this project targets legitimately maps addresses below 64KB.
CONFIG_DEFAULT_MMAP_MIN_ADDR=set-val:65536

# TCP SYN cookies: lets the guest keep accepting legitimate connections under a SYN-flood
# instead of exhausting its (necessarily small, single-app-sized) SYN backlog. Compiled in
# unconditionally — a no-op if `[network].mode = "none"` (no IP stack to have TCP in), and
# free otherwise since it only activates once the real backlog is actually full.
CONFIG_SYN_COOKIES=enable
