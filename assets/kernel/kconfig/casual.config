# Casual profile: no AMD SEV-SNP encryption or attestation device on top of base.config.

# Compiles Lockdown's active level in rather than relying solely on the `lockdown=integrity`
# cmdline flag — LOCKDOWN_LSM_EARLY (self-protection.config) enforces from early boot at
# whatever level this resolves to (default: none), so a cmdline is the wrong single point of
# failure. Can be raised at runtime via `lockdown=confidentiality`, not lowered below this.
# Integrity, not confidentiality: casual makes no confidentiality claim (see
# docs/threat_model.md). sev-snp.config sets confidentiality instead.
CONFIG_LOCK_DOWN_KERNEL_FORCE_INTEGRITY=enable
