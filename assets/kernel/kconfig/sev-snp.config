# SEV-SNP profile additions on top of base.config: AMD memory encryption and the guest
# attestation device the launch measurement and /dev/sev-guest depend on. FIPS is a separate,
# profile-independent opt-in — see kconfig/categories/fips.config.

# AMD SEV-SNP Encryption & Shared Memory
CONFIG_AMD_MEM_ENCRYPT=enable
CONFIG_SWIOTLB=enable
CONFIG_SWIOTLB_DYNAMIC=enable

# SEV-SNP Guest Attestation — /dev/sev-guest, chmod'd into the app's reach by the guest init.
# Fetching/binding reports is the app's job; this image ships no attestation service of its
# own (see docs/threat_model.md).
CONFIG_VIRT_DRIVERS=enable
CONFIG_SEV_GUEST=enable
CONFIG_TSM_REPORTS=enable

# CONFIG_KVM_AMD_SEV is the *hypervisor* side of SEV (running SEV guests) — nothing here ever
# hosts a VM. The guest side is CONFIG_AMD_MEM_ENCRYPT + CONFIG_SEV_GUEST above.
CONFIG_KVM=disable

# Lockdown at confidentiality level, compiled in (see casual.config for why this can't depend
# on the cmdline) — matters more here since `[sev_snp].kernel_cmdline` is fully user-supplied.
CONFIG_LOCK_DOWN_KERNEL_FORCE_CONFIDENTIALITY=enable

# Host supplies the bootloader entropy seed and is hostile on this profile — never credit it
# toward CRNG init. Compiled in rather than left to a user-supplied cmdline flag.
# RDRAND/RDSEED trust has no Kconfig symbol (drivers/char/random.c hardcodes `trust_cpu` to
# true), so there's nothing to set for that half.
CONFIG_RANDOM_TRUST_BOOTLOADER=disable
