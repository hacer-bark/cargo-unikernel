# SEV-SNP profile additions on top of base.config: AMD memory encryption and the SEV-SNP
# guest attestation device — everything the SEV-SNP launch measurement and attestation
# server (unikarnel-init's `attestation` feature) depend on. FIPS crypto capability is a
# separate, profile-independent opt-in — see kconfig/categories/fips.config.

# AMD SEV-SNP Encryption & Shared Memory
CONFIG_AMD_MEM_ENCRYPT=enable
CONFIG_AMD_MEM_ENCRYPT_ACTIVE_BY_DEFAULT=enable
CONFIG_SWIOTLB=enable
CONFIG_SWIOTLB_DYNAMIC=enable

# SEV-SNP Guest Attestation
CONFIG_VIRT_DRIVERS=enable
CONFIG_SEV_GUEST=enable
CONFIG_TSM_REPORTS=enable

# CONFIG_KVM_AMD_SEV (this profile's previous setting here) is the *hypervisor* side of SEV —
# the ability to run SEV guests, pulling in all of CONFIG_KVM/KVM_AMD. Nothing in this image
# ever hosts a VM. The guest side is CONFIG_AMD_MEM_ENCRYPT + CONFIG_SEV_GUEST above, nothing
# else.
CONFIG_KVM=disable

# Lockdown at confidentiality level, compiled in — see casual.config for why this can't depend
# on the cmdline. Matters more here: `[sev_snp].kernel_cmdline` is fully user-supplied, so
# omitting `lockdown=` would otherwise ship a confidential-computing image with Lockdown inert.
# Confidentiality, not integrity, since blocking kernel-memory extraction is the actual claim.
CONFIG_LOCK_DOWN_KERNEL_FORCE_CONFIDENTIALITY=enable

# Host supplies the bootloader entropy seed and is hostile on this profile — never credit it
# toward CRNG init. Compiled in rather than left to `random.trust_bootloader=off` on a cmdline
# that's fully user-supplied here. RDRAND/RDSEED (RANDOM_TRUST_CPU) stays trusted; the host
# can't forge a CPU instruction.
CONFIG_RANDOM_TRUST_BOOTLOADER=disable
CONFIG_RANDOM_TRUST_CPU=enable
